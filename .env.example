# ── Database (PostgreSQL 16 + pgvector) ─────────────────
DATABASE_URL=postgresql://lifeops:lifeops_dev@127.0.0.1:5432/lifeops

# ── Canvas LMS (Any University or canvas.instructure.com) ──
CANVAS_BASE_URL=https://canvas.instructure.com
# Replace with your private Canvas .ics feed (Canvas -> Calendar -> Calendar Feed)
CANVAS_ICS_URL=https://canvas.instructure.com/feeds/calendars/user_PLACEHOLDER.ics

# ── Optional User Profile Defaults (also editable in /setup UI) ─
USER_NAME=
USER_CITY=
USER_TIMEZONE=America/New_York

# ── AI Model Configuration ──────────────────────────────
# Google AI Studio Free Tier (API Key: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
CLOUD_LLM_ENABLED=true

# Local OpenAI-Compatible Server (Ollama / MLX on Apple Silicon)
LOCAL_MODEL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL_NAME=llama3.2:3b
EXAM_MODE=false

# ── Google Workspace (Optional Cloud Sync) ──────────────
GOOGLE_CREDENTIALS_PATH=backend/credentials.json
GOOGLE_TOKEN_PATH=backend/token.json

# ── Application Configuration ───────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000
LOG_LEVEL=INFO
